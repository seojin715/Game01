# Unity 프로젝트에서 깃에 올리지 않을 것들
# (유니티가 자동으로 다시 만들어 주는 파일이라 올릴 필요가 없다)

# 유니티가 자동 생성하는 폴더 - Library는 1GB가 넘는다
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# 유니티가 임시로 만드는 것
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# .meta 파일은 반드시 올려야 한다.
# 이걸 빼면 다른 컴퓨터에서 열었을 때 인스펙터 연결이 전부 끊긴다.
!/[Aa]ssets/**/*.meta

# 비주얼 스튜디오, 라이더 같은 코드 편집기가 만드는 파일
# (유니티가 필요할 때 다시 만든다)
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 빌드 결과물
*.apk
*.aab
*.unitypackage
*.app

# 운영체제가 만드는 파일
.DS_Store
Thumbs.db
desktop.ini
